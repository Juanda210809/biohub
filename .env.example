# Copia este archivo como .env (cp .env.example .env) y cambia las contraseñas si quieres.
# El archivo .env NO se sube a GitHub.

# Base de datos (las 3 bases usan el mismo nombre de base y superusuario)
POSTGRES_DB=biohub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local

# Usuario que copia la tabla pública hacia BD Consulta y BD Reportes
REPLICADOR_PASSWORD=replicador_local

# Un usuario de base de datos por servicio
REGISTRO_DB_PASSWORD=registro_local
GOBERNANZA_DB_PASSWORD=gobernanza_local
IDENTIDAD_DB_PASSWORD=identidad_local
CONSULTA_DB_PASSWORD=consulta_local
REPORTES_DB_PASSWORD=reportes_local

# Clave para firmar los tokens JWT (la usa Identidad)
JWT_SECRET=cambia-esta-clave-en-produccion

# Dirección de Kong que usa el portal desde el navegador
VITE_API_URL=http://localhost:8000
